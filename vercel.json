{
  "version": 2,
  "cleanUrls": false,
  "redirects": [ { "source": "/tr/:path*", "destination": "/", "permanent": false } ],
  "headers": [
    {
      "source": "/(style.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
